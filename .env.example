# Required Environment Variables for ICCLexAI Deployment

# AI Service API Keys (Required)
GROQ_API_KEY=your_groq_api_key_here
# Models must be set explicitly; these worked on 2026-11-06.
ICCLEX_TEXT_MODEL=openai/gpt-oss-120b
ICCLEX_VISION_MODEL=qwen/qwen3.8-27b
ICCLEX_TRANSCRIBE_MODEL=whisper-large-v3-turbo
GOOGLE_API_KEY=your_google_api_key_here
HUGGINGFACE_TOKEN=your_huggingface_token_here
ROBOFLOW_API_KEY=your_roboflow_api_key_here

# Optional AI Services
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Deployment Platform Tokens
NETLIFY_AUTH_TOKEN=your_netlify_auth_token_here
NETLIFY_SITE_ID=your_netlify_site_id_here
RAILWAY_TOKEN=your_railway_token_here
HF_TOKEN=your_huggingface_token_here

# Database Configuration (Optional - Redis for caching)
REDIS_URL=redis://localhost:6379

# Security Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here
ENCRYPTION_KEY=your_encryption_key_here

# Application Configuration
APP_ENV=production
DEBUG=false
MAX_FILE_SIZE=100MB
ALLOWED_FILE_TYPES=pdf,docx,doc,txt,jpg,jpeg,png,mp4,mp3,wav,m4a

# Frontend Configuration
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=ICCLexAI
VITE_APP_VERSION=1.0.0

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
MAX_CONCURRENT_UPLOADS=5

# Monitoring (Optional)
SENTRY_DSN=your_sentry_dsn_here
MIXPANEL_TOKEN=your_mixpanel_token_here
